---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 | Brian" description="This page doesn't exist.">
  <section class="space-y-6">
    <header class="space-y-3">
      <p class="section-label">error 404</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color:var(--text-primary)">command not found</h1>
    </header>
    <pre class="err-term">$ cd {Astro.url.pathname}
bash: cd: {Astro.url.pathname}: No such file or directory
$ <span class="err-caret">▍</span></pre>
    <p class="text-sm" style="color:var(--text-secondary)">
      The page you're looking for moved or never existed. Try one of these instead.
    </p>
    <div class="err-actions">
      <a class="execute-button" href="/">overview</a>
      <a class="execute-button secondary" href="/thoughts">latest writing</a>
    </div>
  </section>
</BaseLayout>

<style>
  .err-term {
    max-width: 38rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    background: var(--tile);
    box-shadow: inset 0 1px 0 var(--tile-shine);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-secondary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .err-caret {
    color: var(--accent);
  }

  .err-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .err-actions :global(.execute-button) {
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem;
  }
</style>
