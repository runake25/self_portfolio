---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 | Brian" description="This page doesn't exist.">
  <section class="space-y-6">
    <p class="section-label">error 404</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color:var(--text-primary)">command not found</h1>
    <pre
      class="text-sm"
      style="font-family:var(--font-mono);color:var(--text-secondary);white-space:pre-wrap;margin:0">$ cd {Astro.url.pathname}
bash: cd: {Astro.url.pathname}: No such file or directory
$ <span style="color:var(--accent)">▍</span></pre>
    <p class="text-sm" style="color:var(--text-secondary)">
      The page you're looking for moved or never existed. Try the <a href="/" style="color:var(--accent);text-decoration:underline">overview</a>
      or the <a href="/thoughts" style="color:var(--accent);text-decoration:underline">latest writing</a>.
    </p>
  </section>
</BaseLayout>
