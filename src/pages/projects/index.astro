---
import CollectionCard from "@/components/content/CollectionCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { entryHref } from "@/utilities/content";
import { tagAccentColor } from "@/utilities/tagColors";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.order - a.data.order || b.data.year - a.data.year,
);
---

<BaseLayout title="Gallery | Brian" description="A gallery of selected projects.">
  <section class="space-y-8">
    <p class="section-label">topic</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color:var(--text-primary)">Gallery</h1>
    <p class="max-w-3xl text-sm" style="color:var(--text-secondary)">
      A collection of things I find interesting and worth sharing. I hope you find them interesting as well.
    </p>

    {
      projects.length === 0 ? (
        <p style="color:var(--text-faint)">No projects yet. Working hard to bring one...</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {projects.map((project) => (
            <CollectionCard
              href={entryHref("projects", project.id)}
              title={project.data.title}
              description={project.data.description}
              meta={String(project.data.year)}
              tags={project.data.tags}
              accentColor={tagAccentColor(project.data.tags)}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
