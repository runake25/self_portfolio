---
// Fonts are self-hosted (Fontsource) instead of loaded from Google Fonts:
// no extra DNS/TLS handshakes to two third-party origins, no render-blocking
// cross-origin stylesheet, and the files are cached with our own immutable hashes.
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import spaceGroteskLatin from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import jetbrainsMonoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import sketchImg from "@/assets/sketch.png";

interface AdjacentPage {
  title: string;
  url: string;
  label: string;
}

interface Props {
  title?: string;
  description?: string;
  prevPage?: AdjacentPage | null;
  nextPage?: AdjacentPage | null;
  noSketch?: boolean;
  bgPoster?: string;
  bgCapture?: ImageMetadata;
  /** "article" for blog posts; drives the Open Graph type. */
  ogType?: "website" | "article";
  /** Long-form pages: the window grows to use more of the screen. */
  reading?: boolean;
}

const {
  title = "Brian::sharespace",
  description = "Brian — data engineer in Hong Kong. Projects, writing, and the films and music I love.",
  prevPage,
  nextPage,
  noSketch = false,
  bgPoster,
  bgCapture,
  ogType = "website",
  reading = false,
} = Astro.props;

const navigation = [
  { href: "/", label: "overview" },
  { href: "/projects", label: "gallery" },
  { href: "/thoughts", label: "thoughts" },
  { href: "/contact", label: "contact" },
];

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath === "/" ? "/overview" : currentPath.replace(/\/$/, "") || "/";
const breadcrumbPath = `~/projects/self-portfolio${normalizedPath}`;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site).href : undefined;
// Link previews need an absolute URL. public/og.png is the shared preview card.
const ogImage = new URL("/og.png", Astro.site ?? Astro.url).href;

const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || "https://github.com/runake25";
const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL || "";

function isActivePath(href: string) {
  return href === "/" ? currentPath === "/" : currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Brian::sharespace" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brian::sharespace — a maze, a sketch, and a terminal prompt" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Brian::sharespace — thoughts" href="/rss.xml" />
    <meta name="theme-color" content="#0b0b14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ede0cc" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoLatin} as="font" type="font/woff2" crossorigin />
    <!-- Runs before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = null;
        let uiHidden = false;
        try {
          theme = localStorage.getItem("portfolio-theme");
          uiHidden = localStorage.getItem("portfolio-ui-hidden") === "1";
        } catch {}
        if (theme !== "day" && theme !== "night") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "day";
        }
        root.dataset.theme = theme;
        root.dataset.uiHidden = String(uiHidden);
      })();
    </script>
    <ClientRouter />
    <script>
      import "@/scripts/site";
    </script>
  </head>
  <body>
    <canvas class="maze-canvas" data-maze-canvas aria-hidden="true" transition:persist="maze-canvas"></canvas>
    <div class="maze-ball" data-maze-ball aria-hidden="true" transition:persist="maze-ball">
      <div class="maze-ball-ring"></div>
      <div class="maze-ball-core"><div class="maze-ball-skin"></div></div>
    </div>
    <p class="maze-hint" aria-hidden="true">click the maze to play</p>
    <div class="bg-grid" aria-hidden="true"></div>

    <button class="ui-visibility-toggle" type="button" data-ui-toggle data-lens="9" aria-label="Hide interface" aria-pressed="false">
      <span class="ui-toggle-icons" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" focusable="false">
          <rect x="1.2" y="1.2" width="10.6" height="10.6" rx="1.2" stroke="currentColor" stroke-width="1"></rect>
          <path d="M3.2 9.5H9.8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
        </svg>
        <span class="ui-toggle-sep"></span>
        <svg width="13" height="13" viewBox="0 0 13 13" fill="none" focusable="false">
          <path d="M1.5 5V1.5H5" stroke="currentColor" stroke-width="1" stroke-linecap="round"></path>
          <path d="M8 1.5H11.5V5" stroke="currentColor" stroke-width="1" stroke-linecap="round"></path>
          <path d="M11.5 8V11.5H8" stroke="currentColor" stroke-width="1" stroke-linecap="round"></path>
          <path d="M5 11.5H1.5V8" stroke="currentColor" stroke-width="1" stroke-linecap="round"></path>
        </svg>
      </span>
    </button>

    <div class="site-shell" data-reading={reading ? "" : undefined}>
      {(!noSketch || bgPoster || bgCapture) && (
        <div class="shell-art" aria-hidden="true">
          {!noSketch && (
            <div class="sketch-wrap" transition:persist="sketch">
            <Image
              src={sketchImg}
              alt=""
              class="sketch-bg"
              widths={[480, 720, 1024]}
              sizes="(max-width: 940px) 90vw, 720px"
              format="avif"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            </div>
          )}
          {(bgCapture || bgPoster) && (
            <div class="shell-poster-bg">
              {bgCapture ? (
                <Image src={bgCapture} alt="" class="shell-poster-img" widths={[640, 960, 1280]} sizes="60vw" format="avif" decoding="async" />
              ) : (
                <Image src={bgPoster!} inferSize alt="" class="shell-poster-img" format="avif" decoding="async" />
              )}
            </div>
          )}
        </div>
      )}
      <header class="site-header">
        <div class="header-brand">
          <a class="brand" href="/">Brian::sharespace</a>
          <div class="brand-socials">
            <a class="brand-social-link" href={githubUrl} target="_blank" rel="noreferrer noopener" aria-label="GitHub profile">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.49.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.742 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path>
              </svg>
            </a>
            {linkedinUrl && (
              <a class="brand-social-link" href={linkedinUrl} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn profile">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
        <!-- Desktop: a segmented control in the header row. Phones: a floating tab bar.
             The active "pill" carries a view-transition name, so it glides to the new tab. -->
        <nav class="site-nav" aria-label="Main navigation" data-lens="16">
          {
            navigation.map((item) => (
              <a class="nav-link" data-active={isActivePath(item.href)} aria-current={isActivePath(item.href) ? "page" : undefined} href={item.href} data-astro-prefetch="load">
                {isActivePath(item.href) && <span class="nav-pill" aria-hidden="true"></span>}
                <span class="nav-label">{item.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <button class="mode-toggle" type="button" data-theme-toggle aria-label="Toggle day and night theme" aria-pressed="false">
            <span class="mode-icon mode-icon-sun" aria-hidden="true"></span>
            <span class="mode-icon mode-icon-moon" aria-hidden="true"></span>
          </button>
        </div>
      </header>


      <main id="main-content" class="page-content" tabindex="-1">
        <div class="page-content-inner">
          <slot />
        </div>

        {(prevPage || nextPage) && (
          <nav class="entry-footer-nav" aria-label="Entry navigation">
            {prevPage && (
              <a href={prevPage.url} class="entry-prev">
                <p class="section-label">{prevPage.label}</p>
                <p>{prevPage.title}</p>
              </a>
            )}
            {nextPage && (
              <a href={nextPage.url} class="entry-next">
                <p class="section-label">{nextPage.label}</p>
                <p>{nextPage.title}</p>
              </a>
            )}
          </nav>
        )}
      </main>

      <footer class="site-footer">
        <span class="footer-left">
          <span class="status-marker" aria-hidden="true"></span>
          <span class="breadcrumb">{breadcrumbPath}</span>
        </span>
        <div class="footer-right">
          <button class="footer-cmd" type="button" data-palette-open aria-label="Open command palette (shortcut: /)">
            <kbd>/</kbd> commands
          </button>
          <span class="footer-clock" data-local-time>--:--:--</span>
        </div>
      </footer>
    </div>
  </body>
</html>
