---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  tags?: string[];
  /** Kept so existing callers keep compiling; cards no longer carry a coloured stripe. */
  accentColor?: string;
  readTime?: number;
}

const { href, title, description, meta, tags = [], readTime } = Astro.props;
---

<article class="card-link collection-card h-full">
  <a href={href} class="collection-link">
    {
      (meta || readTime) && (
        <p class="collection-meta">
          {meta && <span>{meta}</span>}
          {meta && readTime && <span aria-hidden="true">·</span>}
          {readTime && <span>{readTime} min read</span>}
        </p>
      )
    }
    <div class="collection-head">
      <h2 class="collection-title">{title}</h2>
      <span class="card-arrow" aria-hidden="true">→</span>
    </div>
    {description && <p class="collection-desc">{description}</p>}
    {
      tags.length > 0 && (
        <div class="collection-tags">
          {tags.map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )
    }
  </a>
</article>

<style>
  .collection-card {
    padding: 1.3rem 1.4rem 1.4rem;
  }

  .collection-link {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    transition: scale 420ms var(--spring);
  }

  .collection-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
    color: var(--text-faint);
  }

  .collection-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .collection-title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 1.28rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .collection-card :global(.card-arrow) {
    flex-shrink: 0;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    transition:
      color 200ms var(--ease-out),
      translate 420ms var(--spring);
  }

  .collection-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .collection-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .collection-card:has(> a:hover) :global(.card-arrow) {
      color: var(--accent);
      translate: 3px 0;
    }
  }

  @media (max-width: 940px) {
    .collection-card {
      padding: 1.1rem 1.1rem 1.15rem;
    }
  }
</style>
